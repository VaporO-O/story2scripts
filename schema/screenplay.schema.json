{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2script.local/schema/screenplay.schema.json",
  "title": "Story2Script Screenplay",
  "description": "Machine-readable schema for a structured novel-to-screenplay draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "genre",
    "adaptation_type",
    "logline",
    "source",
    "global_state",
    "characters",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string"
    },
    "adaptation_type": {
      "type": "string",
      "enum": [
        "短剧",
        "影视剧",
        "舞台剧",
        "广播剧",
        "分镜脚本"
      ],
      "description": "Target adaptation style for the screenplay draft."
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_count",
        "chapter_titles"
      ],
      "properties": {
        "chapter_count": {
          "type": "integer",
          "minimum": 3
        },
        "chapter_titles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "global_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fixed cross-chapter state table used to keep chunked conversion consistent.",
      "required": [
        "characters",
        "locations",
        "timeline"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "aliases",
              "first_appearance",
              "appearance_chapters",
              "traits",
              "goal",
              "arc",
              "consistency_note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^character-[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "first_appearance": {
                "type": "string",
                "minLength": 1
              },
              "appearance_chapters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "traits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "goal": {
                "type": "string"
              },
              "arc": {
                "type": "string",
                "minLength": 1
              },
              "consistency_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "first_appearance",
              "appearance_chapters",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^location-[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "first_appearance": {
                "type": "string",
                "minLength": 1
              },
              "appearance_chapters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "chapter",
              "time_marker",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^event-[0-9]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "chapter": {
                "type": "string",
                "minLength": 1
              },
              "time_marker": {
                "type": "string"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "motivation",
          "arc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "motivation": {
            "type": "string"
          },
          "arc": {
            "type": "string",
            "minLength": 1,
            "description": "Character arc across the screenplay"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "id",
            "heading",
            "int_ext",
            "time_of_day",
            "location",
            "source_chapter",
            "summary",
            "goal",
            "conflict",
            "beat",
            "subtext",
            "characters",
            "characters_present",
            "props",
            "dramatization_decisions",
            "elements"
          ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene-[0-9]+$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "int_ext": {
            "type": "string",
            "enum": [
              "INT.",
              "EXT."
            ],
            "description": "Industry slug-line interior/exterior marker."
          },
          "time_of_day": {
            "type": "string",
            "enum": [
              "DAY",
              "NIGHT"
            ],
            "description": "Industry slug-line time marker."
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "source_chapter": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "conflict": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string",
            "minLength": 1
          },
          "subtext": {
            "type": "string",
            "minLength": 1
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "characters_present": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dramatization_decisions": {
            "type": "array",
            "minItems": 1,
            "description": "Explicit narration-to-drama classification decisions for this scene.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_text",
                "target",
                "rendering",
                "reason"
              ],
              "properties": {
                "source_text": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "action",
                    "dialogue",
                    "subtext",
                    "scene_description"
                  ]
                },
                "rendering": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "camera_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "action"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "character",
                    "parenthetical",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "dialogue"
                    },
                    "character": {
                      "type": "string"
                    },
                    "parenthetical": {
                      "type": "string"
                    },
                    "emotion": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
