{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2script.local/schema/screenplay.schema.json",
  "title": "Story2Script Screenplay",
  "description": "Machine-readable schema for a structured novel-to-screenplay draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "genre",
    "adaptation_type",
    "logline",
    "source",
    "global_state",
    "characters",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string"
    },
    "adaptation_type": {
      "type": "string",
      "enum": [
        "短剧",
        "影视剧",
        "舞台剧",
        "广播剧",
        "分镜脚本"
      ],
      "description": "Target adaptation style for the screenplay draft."
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_count",
        "chapter_titles"
      ],
      "properties": {
        "chapter_count": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_titles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "global_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fixed cross-chapter state table used to keep chunked conversion consistent.",
      "required": [
        "characters",
        "locations",
        "timeline"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "aliases",
              "first_appearance",
              "appearance_chapters",
              "traits",
              "goal",
              "arc",
              "consistency_note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^character-[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "first_appearance": {
                "type": "string",
                "minLength": 1
              },
              "appearance_chapters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "traits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "goal": {
                "type": "string"
              },
              "arc": {
                "type": "string",
                "minLength": 1
              },
              "consistency_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "first_appearance",
              "appearance_chapters",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^location-[0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "first_appearance": {
                "type": "string",
                "minLength": 1
              },
              "appearance_chapters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "chapter",
              "time_marker",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^event-[0-9]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "chapter": {
                "type": "string",
                "minLength": 1
              },
              "time_marker": {
                "type": "string"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "motivation",
          "arc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "motivation": {
            "type": "string"
          },
          "arc": {
            "type": "string",
            "minLength": 1,
            "description": "Character arc across the screenplay"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "int_ext",
          "time_of_day",
          "location",
          "source_chapter",
          "summary",
          "goal",
          "conflict",
          "beat",
          "subtext",
          "characters",
          "characters_present",
          "props",
          "dramatization_decisions",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene-[0-9]+$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "int_ext": {
            "type": "string",
            "enum": [
              "INT.",
              "EXT."
            ],
            "description": "Industry slug-line interior/exterior marker."
          },
          "time_of_day": {
            "type": "string",
            "enum": [
              "DAY",
              "NIGHT"
            ],
            "description": "Industry slug-line time marker."
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "source_chapter": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "conflict": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string",
            "minLength": 1
          },
          "subtext": {
            "type": "string",
            "minLength": 1
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "characters_present": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "props": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dramatization_decisions": {
            "type": "array",
            "minItems": 1,
            "description": "Explicit narration-to-drama classification decisions for this scene.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_text",
                "target",
                "rendering",
                "reason"
              ],
              "properties": {
                "source_text": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "action",
                    "dialogue",
                    "subtext",
                    "scene_description"
                  ]
                },
                "rendering": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "camera_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "action"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "character",
                    "parenthetical",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "dialogue"
                    },
                    "character": {
                      "type": "string"
                    },
                    "parenthetical": {
                      "type": "string"
                    },
                    "emotion": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "timeline_mode": {
            "type": "string",
            "enum": [
              "present",
              "flashback",
              "recording",
              "dream"
            ],
            "default": "present"
          },
          "event_time_scene_id": {
            "type": "string",
            "default": "",
            "description": "Past event anchored at scene start"
          }
        }
      }
    },
    "plot_state": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "revision_id": {
              "title": "Revision Id",
              "type": "string"
            },
            "changes": {
              "items": {
                "$ref": "#/$defs/PlotChange"
              },
              "title": "Changes",
              "type": "array"
            },
            "facts": {
              "items": {
                "$ref": "#/$defs/StoryFact"
              },
              "title": "Facts",
              "type": "array"
            },
            "logic": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StoryLogic"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "revision_id"
          ],
          "title": "PlotContinuity",
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "creative_brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreativeBrief"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "structure": {
      "items": {
        "$ref": "#/$defs/SceneGroup"
      },
      "title": "Structure",
      "type": "array"
    },
    "editing": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditingState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "$defs": {
    "PlotChange": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "effective_scene_id": {
          "title": "Effective Scene Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "death",
            "exit",
            "revive",
            "return",
            "transfer",
            "move",
            "learn",
            "relationship",
            "custom"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "item": {
          "default": "",
          "title": "Item",
          "type": "string"
        },
        "destination": {
          "default": "",
          "title": "Destination",
          "type": "string"
        },
        "secret": {
          "default": "",
          "title": "Secret",
          "type": "string"
        },
        "relationship": {
          "default": "",
          "enum": [
            "",
            "ally",
            "enemy",
            "neutral"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "source_character": {
          "default": "",
          "title": "Source Character",
          "type": "string"
        },
        "source_item": {
          "default": "",
          "title": "Source Item",
          "type": "string"
        },
        "custom_rule": {
          "default": "",
          "title": "Custom Rule",
          "type": "string"
        },
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Bindings",
          "type": "object"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Requires",
          "type": "array"
        },
        "event_time": {
          "const": "scene_end",
          "default": "scene_end",
          "title": "Event Time",
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "instruction",
        "character_id",
        "effective_scene_id",
        "operation"
      ],
      "title": "PlotChange",
      "type": "object"
    },
    "StoryFact": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "valid_from_scene_id": {
          "title": "Valid From Scene Id",
          "type": "string"
        },
        "source": {
          "default": "scene",
          "enum": [
            "user",
            "scene"
          ],
          "title": "Source",
          "type": "string"
        },
        "revision_id": {
          "default": "",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate",
        "value",
        "valid_from_scene_id"
      ],
      "title": "StoryFact",
      "type": "object"
    },
    "ElementCoverage": {
      "additionalProperties": false,
      "properties": {
        "element_index": {
          "minimum": 0,
          "title": "Element Index",
          "type": "integer"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "context_only": {
          "default": false,
          "title": "Context Only",
          "type": "boolean"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "element_index",
        "explanation"
      ],
      "title": "ElementCoverage",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "item",
            "location",
            "secret"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "item": {
          "default": "",
          "title": "Item",
          "type": "string"
        },
        "destination": {
          "default": "",
          "title": "Destination",
          "type": "string"
        },
        "secret": {
          "default": "",
          "title": "Secret",
          "type": "string"
        },
        "relationship": {
          "default": "",
          "enum": [
            "",
            "ally",
            "enemy",
            "neutral"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "source_character": {
          "default": "",
          "title": "Source Character",
          "type": "string"
        },
        "source_item": {
          "default": "",
          "title": "Source Item",
          "type": "string"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Requires",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "death",
            "exit",
            "revive",
            "return",
            "transfer",
            "move",
            "learn",
            "relationship",
            "act",
            "use_item",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "custom_rule": {
          "default": "",
          "title": "Custom Rule",
          "type": "string"
        },
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Bindings",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "id",
        "kind"
      ],
      "title": "Event",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "element_index": {
          "minimum": 0,
          "title": "Element Index",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "element_index",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "predicate": {
          "pattern": "^(alive|available|at|owner|knows|contains|relationship|custom:[a-z][a-z0-9_]{0,63})$",
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate",
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "InitialFact": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/Fact"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "assumption": {
          "default": false,
          "title": "Assumption",
          "type": "boolean"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "fact",
        "explanation"
      ],
      "title": "InitialFact",
      "type": "object"
    },
    "SceneLogic": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/ElementCoverage"
          },
          "title": "Coverage",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "events",
        "coverage"
      ],
      "title": "SceneLogic",
      "type": "object"
    },
    "StoryLogic": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "1",
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        },
        "initial_facts": {
          "items": {
            "$ref": "#/$defs/InitialFact"
          },
          "title": "Initial Facts",
          "type": "array"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneLogic"
          },
          "title": "Scenes",
          "type": "array"
        },
        "initial_source": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Initial Source",
          "type": "object"
        },
        "initial_source_hash": {
          "default": "",
          "title": "Initial Source Hash",
          "type": "string"
        },
        "custom_properties": {
          "items": {
            "$ref": "#/$defs/CustomProperty"
          },
          "maxItems": 64,
          "title": "Custom Properties",
          "type": "array"
        },
        "custom_rules": {
          "items": {
            "$ref": "#/$defs/CustomRule"
          },
          "maxItems": 64,
          "title": "Custom Rules",
          "type": "array"
        }
      },
      "required": [
        "entities",
        "initial_facts",
        "scenes"
      ],
      "title": "StoryLogic",
      "type": "object"
    },
    "CustomProperty": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^custom:[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "character",
            "item",
            "location",
            "secret"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "target_kind": {
          "default": "",
          "enum": [
            "",
            "character",
            "item",
            "location",
            "secret"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "symmetric": {
          "default": false,
          "title": "Symmetric",
          "type": "boolean"
        },
        "usable_values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Usable Values",
          "type": "array"
