{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story2script.local/schema/screenplay.schema.json",
  "title": "Story2Script Screenplay",
  "description": "Machine-readable schema for a structured novel-to-screenplay draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "genre",
    "adaptation_type",
    "logline",
    "source",
    "characters",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string"
    },
    "adaptation_type": {
      "type": "string",
      "enum": [
        "短剧",
        "影视剧",
        "舞台剧",
        "广播剧",
        "分镜脚本"
      ],
      "description": "Target adaptation style for the screenplay draft."
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_count",
        "chapter_titles"
      ],
      "properties": {
        "chapter_count": {
          "type": "integer",
          "minimum": 3
        },
        "chapter_titles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "motivation",
          "arc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "motivation": {
            "type": "string"
          },
          "arc": {
            "type": "string",
            "minLength": 1,
            "description": "Character arc across the screenplay"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "source_chapter",
          "summary",
          "goal",
          "conflict",
          "beat",
          "subtext",
          "characters",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene-[0-9]+$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "source_chapter": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "conflict": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string",
            "minLength": 1
          },
          "subtext": {
            "type": "string",
            "minLength": 1
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "camera_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "action"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "character",
                    "parenthetical",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "dialogue"
                    },
                    "character": {
                      "type": "string"
                    },
                    "parenthetical": {
                      "type": "string"
                    },
                    "emotion": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
