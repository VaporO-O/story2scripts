# Export these variables to BOTH Web and Worker processes.
# Infrastructure settings intentionally use environment, not the provider .env writer.
STORY2SCRIPT_TASK_BACKEND=redis
STORY2SCRIPT_REDIS_URL=redis://127.0.0.1:6379/0
STORY2SCRIPT_REDIS_NAMESPACE=story2script
# Use the SAME absolute path in Web and every Worker on this host.
STORY2SCRIPT_JOBS_DB=/absolute/path/to/project/.story2script/jobs.db
STORY2SCRIPT_CACHE_BACKEND=redis
STORY2SCRIPT_REDIS_CACHE_TTL=86400
STORY2SCRIPT_REDIS_CACHE_MAX_BYTES=2000000
STORY2SCRIPT_LLM_RPM=60
STORY2SCRIPT_EMBED_RPM=120
STORY2SCRIPT_REDIS_DISPATCH_SECONDS=60
STORY2SCRIPT_REDIS_EVENT_TTL=86400
STORY2SCRIPT_REDIS_EVENT_LIMIT=1000
STORY2SCRIPT_REDIS_VISIBILITY_TIMEOUT=14400
